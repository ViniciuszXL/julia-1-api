# Provider: julia (default) or decider
MODEL_PROVIDER=julia
MODEL_ID=SupersonicLabs/Julia-1
MODEL_PATH=/models/Julia-1
MODEL_DEVICE=cpu
MODEL_CPU_THREADS=4
MODEL_MAX_CONCURRENCY=2
MODEL_RATE_LIMIT_RPM=60
MODEL_MAX_BODY_BYTES=262144
MODEL_TRUST_PROXY_HEADERS=true

OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4

# Legacy JULIA_* variables remain supported for backwards compatibility.
